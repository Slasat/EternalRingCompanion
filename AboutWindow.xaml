<Window x:Class="EternalRingCompanion.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About" Height="300" Width="460"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        Background="{StaticResource WindowGround}" AllowsTransparency="False">
    <Border BorderBrush="{StaticResource Bronze}" BorderThickness="2">
        <ContentControl Style="{StaticResource Frame}" Padding="26,22">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Content="Close" Style="{StaticResource AccentButton}" Click="OnClose"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Eternal Ring Companion" Style="{StaticResource H1}"/>
                    <TextBlock x:Name="VersionText" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                    <Border Style="{StaticResource Rule}"/>

                    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                               Text="Live memory editor for Eternal Ring (PAL, SLES-500.51) running under PCSX2."/>

                    <TextBlock Margin="0,16,0,0" Foreground="{StaticResource LabelBlue}" Text="Credits"/>
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                        <Run Text="Created by "/><Run Text="Slasat" FontWeight="Bold"/><Run Text="."/>
                    </TextBlock>
                    <TextBlock Margin="0,2,0,0" TextWrapping="Wrap"
                               Text="With support from members of the Discord server &quot;Eternal Ring's Island of Going Fast&quot;."/>
                </StackPanel>
            </DockPanel>
        </ContentControl>
    </Border>
</Window>
