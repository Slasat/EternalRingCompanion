<Window x:Class="EternalRingCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Eternal Ring Companion" Height="770" Width="1140"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource WindowGround}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource Bronze}" BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <!-- ===================== Title bar ===================== -->
            <Grid Grid.Row="0" Background="{StaticResource StoneDark}">
                <Border Height="2" VerticalAlignment="Bottom" Background="{StaticResource Bronze}"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Rectangle Width="8" Height="8" Fill="{StaticResource Accent}" VerticalAlignment="Center">
                        <Rectangle.RenderTransform>
                            <RotateTransform Angle="45" CenterX="4" CenterY="4"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <TextBlock Text="ETERNAL RING COMPANION" FontFamily="{StaticResource TitleFont}"
                               FontSize="12" Typography.Capitals="SmallCaps"
                               Foreground="{StaticResource TextMuted}" Margin="11,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="MinBtn" Style="{StaticResource CaptionButton}" Click="OnMinimize" ToolTip="Minimize">
                        <Rectangle Width="11" Height="1" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button x:Name="MaxBtn" Style="{StaticResource CaptionButton}" Click="OnMaximize" ToolTip="Maximize">
                        <Rectangle Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   StrokeThickness="1" Fill="Transparent"/>
                    </Button>
                    <Button x:Name="CloseBtn" Style="{StaticResource CloseButton}" Click="OnClose" ToolTip="Close">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===================== Body ===================== -->
            <Grid Grid.Row="1" Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="196"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Menu column -->
                <DockPanel Grid.Column="0">
                    <TextBlock DockPanel.Dock="Top" Text="Menu" Style="{StaticResource SectionLabel}"
                               FontSize="14" Margin="2,0,0,8"/>
                    <StackPanel x:Name="Nav" DockPanel.Dock="Top">
                        <RadioButton x:Name="NavPlayer" Style="{StaticResource NavItem}" GroupName="nav"
                                     Content="Player Stats" IsChecked="True" Checked="OnNavChecked"/>
                        <RadioButton x:Name="NavInventory" Style="{StaticResource NavItem}" GroupName="nav"
                                     Content="Inventory" Checked="OnNavChecked"/>
                        <RadioButton x:Name="NavTeleport" Style="{StaticResource NavItem}" GroupName="nav"
                                     Content="Teleport" Checked="OnNavChecked"/>
                    </StackPanel>
                    <TextBlock/>
                </DockPanel>

                <!-- Page host -->
                <ContentControl x:Name="PageHost" Grid.Column="2"/>
            </Grid>

            <!-- ===================== Status bar ===================== -->
            <Grid Grid.Row="2" Background="{StaticResource StoneDark}">
                <Border Height="2" VerticalAlignment="Top" Background="{StaticResource Bronze}"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Rectangle x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource Danger}" VerticalAlignment="Center">
                        <Rectangle.RenderTransform>
                            <RotateTransform Angle="45" CenterX="4" CenterY="4"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <TextBlock x:Name="StatusText" Text="No link" Margin="9,0,0,0" VerticalAlignment="Center"
                               FontFamily="{StaticResource TitleFont}" Typography.Capitals="SmallCaps" FontSize="12.5"/>
                    <TextBlock x:Name="StatusSub" Style="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <Button x:Name="ConnectBtn" Style="{StaticResource GhostButton}" Content="Connect"
                            Margin="12,0,0,0" VerticalAlignment="Center" Click="OnConnectClick"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Eternal Ring · PAL" VerticalAlignment="Center" Style="{StaticResource Muted}"/>
                    <Button Content="About" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                            VerticalAlignment="Center" Click="OnAbout"/>
                </StackPanel>
            </Grid>

            <!-- CRT scanlines over the whole surface -->
            <Rectangle Grid.RowSpan="3" Fill="{StaticResource Scanlines}" IsHitTestVisible="False"/>
        </Grid>
    </Border>
</Window>
