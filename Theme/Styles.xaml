<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- =====================================================================
         Modelled directly on Eternal Ring's own pause menu: pure-black
         panels with heavy bronze bevelled frames and corner gussets,
         floating on cool dark stone; bronze name-plaque list with a blue
         stud; blue-grey secondary labels, gold emphasis, white values.
         ===================================================================== -->

    <!-- ============================ Palette ============================ -->
    <Color x:Key="StoneColor">#FF26262B</Color>
    <Color x:Key="StoneDarkColor">#FF171719</Color>
    <Color x:Key="PanelColor">#FF050506</Color>

    <Color x:Key="BronzeLoColor">#FF3E2F19</Color>
    <Color x:Key="BronzeMidColor">#FF7A5E34</Color>
    <Color x:Key="BronzeHiColor">#FFCBA867</Color>

    <Color x:Key="TextColor">#FFE9E6DA</Color>        <!-- near-white -->
    <Color x:Key="TextMutedColor">#FF8C8A80</Color>
    <Color x:Key="LabelBlueColor">#FF8FA8BC</Color>   <!-- LEVEL / EXP-style labels -->
    <Color x:Key="GoldColor">#FFD8C24C</Color>        <!-- EXP / NEXT emphasis -->
    <Color x:Key="GoldBrightColor">#FFF1E08A</Color>
    <Color x:Key="StudBlueColor">#FF4C84B8</Color>
    <Color x:Key="InkColor">#FF191308</Color>

    <Color x:Key="DangerColor">#FFC15446</Color>
    <Color x:Key="HpColor">#FFD8C24C</Color>
    <Color x:Key="MpColor">#FF7FA85C</Color>

    <SolidColorBrush x:Key="Stone" Color="{StaticResource StoneColor}"/>
    <SolidColorBrush x:Key="StoneDark" Color="{StaticResource StoneDarkColor}"/>
    <SolidColorBrush x:Key="BronzeHi" Color="{StaticResource BronzeHiColor}"/>
    <SolidColorBrush x:Key="WindowBg" Color="{StaticResource StoneColor}"/>
    <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="Surface" Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="SurfaceAlt" Color="#FF0C0C0E"/>
    <SolidColorBrush x:Key="SurfaceHover" Color="#FF1A1A1E"/>
    <SolidColorBrush x:Key="Inset" Color="#FF030304"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#FF3A2E1B"/>
    <SolidColorBrush x:Key="GoldLine" Color="{StaticResource BronzeMidColor}"/>
    <SolidColorBrush x:Key="GoldDeep" Color="#FF5A4626"/>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource GoldColor}"/>
    <SolidColorBrush x:Key="AccentBright" Color="{StaticResource GoldBrightColor}"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#2ED8C24C"/>
    <SolidColorBrush x:Key="LabelBlue" Color="{StaticResource LabelBlueColor}"/>
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextMuted" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}"/>
    <SolidColorBrush x:Key="Stud" Color="{StaticResource StudBlueColor}"/>
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="Good" Color="{StaticResource GoldColor}"/>
    <SolidColorBrush x:Key="GaugeHp" Color="{StaticResource HpColor}"/>
    <SolidColorBrush x:Key="GaugeMp" Color="{StaticResource MpColor}"/>

    <SolidColorBrush x:Key="ElemFire" Color="#FFC85A3C"/>
    <SolidColorBrush x:Key="ElemEarth" Color="#FFC9A24A"/>
    <SolidColorBrush x:Key="ElemWind" Color="#FF6FA85C"/>
    <SolidColorBrush x:Key="ElemWater" Color="#FF4C84B8"/>
    <SolidColorBrush x:Key="ElemLight" Color="#FFE4D9AE"/>
    <SolidColorBrush x:Key="ElemDark" Color="#FF9A7CC0"/>
    <SolidColorBrush x:Key="ElemStr" Color="#FFBE9A5E"/>

    <!-- bronze bevel: lit top-left to shadowed bottom-right -->
    <LinearGradientBrush x:Key="Bronze" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BronzeHiColor}" Offset="0"/>
        <GradientStop Color="{StaticResource BronzeMidColor}" Offset="0.45"/>
        <GradientStop Color="{StaticResource BronzeLoColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PlaqueOff" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF4E3E24" Offset="0"/>
        <GradientStop Color="#FF322815" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PlaqueOn" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFB79256" Offset="0"/>
        <GradientStop Color="#FF8A6C3E" Offset="0.5"/>
        <GradientStop Color="#FF6B5230" Offset="1"/>
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="WindowGround" GradientOrigin="0.5,0.0" Center="0.5,0.0" RadiusX="1.4" RadiusY="1.3">
        <GradientStop Color="#FF2C2C31" Offset="0"/>
        <GradientStop Color="#FF202024" Offset="0.55"/>
        <GradientStop Color="#FF121214" Offset="1"/>
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="RuleBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource BronzeHiColor}" Offset="0"/>
        <GradientStop Color="#66906F34" Offset="0.6"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CursorBar" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00000000" Offset="0"/>
        <GradientStop Color="#3AD8C24C" Offset="0.05"/>
        <GradientStop Color="#12D8C24C" Offset="0.8"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>

    <DrawingBrush x:Key="LeaderBrush" TileMode="Tile" Viewport="0,0,5,2" ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#66807A66">
                <GeometryDrawing.Geometry>
                    <EllipseGeometry Center="0.9,1" RadiusX="0.7" RadiusY="0.7"/>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DrawingBrush x:Key="Scanlines" TileMode="Tile" Viewport="0,0,2,3" ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#12000000">
                <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,2,1"/></GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <FontFamily x:Key="TitleFont">Palatino Linotype, Book Antiqua, Georgia, serif</FontFamily>
    <FontFamily x:Key="UiFont">Trebuchet MS, Verdana, sans-serif</FontFamily>
    <FontFamily x:Key="ValueFont">Consolas, Lucida Console, monospace</FontFamily>
    <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

    <CornerRadius x:Key="Radius">0</CornerRadius>
    <CornerRadius x:Key="RadiusSm">0</CornerRadius>
    <CornerRadius x:Key="RadiusPill">0</CornerRadius>

    <!-- ============================ Text ============================ -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TitleFont}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="Typography.Capitals" Value="SmallCaps"/>
    </Style>

    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TitleFont}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Typography.Capitals" Value="SmallCaps"/>
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TitleFont}"/>
        <Setter Property="Foreground" Value="{StaticResource LabelBlue}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Typography.Capitals" Value="SmallCaps"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="Rule" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{StaticResource RuleBrush}"/>
        <Setter Property="Margin" Value="0,7,0,0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ============================ Bronze-framed black panel ============================ -->
    <Style x:Key="Frame" TargetType="ContentControl">
        <Setter Property="Padding" Value="20,16"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Bronze}" BorderThickness="2"/>
                        <Border BorderBrush="#FF14100A" BorderThickness="1" Margin="2"/>
                        <Polygon Points="0,0 16,0 0,16" Fill="{StaticResource Bronze}" HorizontalAlignment="Left"  VerticalAlignment="Top"/>
                        <Polygon Points="0,0 16,0 16,16" Fill="{StaticResource Bronze}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        <Polygon Points="0,0 0,16 16,16" Fill="{StaticResource Bronze}" HorizontalAlignment="Left"  VerticalAlignment="Bottom"/>
                        <Polygon Points="16,0 16,16 0,16" Fill="{StaticResource Bronze}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Panel}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Bronze}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ============================ Buttons — [ LABEL ] ============================ -->
    <Style x:Key="AccentButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource TitleFont}"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBright}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Typography.Capitals" Value="SmallCaps"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource GoldLine}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="[" Foreground="{StaticResource Accent}" Margin="0,0,5,0"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                            <TextBlock Text="]" Foreground="{StaticResource Accent}" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource AccentSoft}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#22000000"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#FF66604F"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                            <Setter TargetName="b" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="7,4"/>
    </Style>

    <!-- caption-bar buttons -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF2A2A30"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentBright}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FF7A2A22"/>
                <Setter Property="Foreground" Value="#FFEFE4CE"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================ Nav — bronze name-plaques ============================ -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource TitleFont}"/>
        <Setter Property="Foreground" Value="#FFBDB6A4"/>
        <Setter Property="FontSize" Value="14.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid MinHeight="44">
                        <Border x:Name="plate" Background="{StaticResource PlaqueOff}"
                                BorderBrush="#FF241B0F" BorderThickness="1"/>
                        <Border x:Name="hi" BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0" Margin="1,1,1,0"/>
                        <Rectangle x:Name="stud" Width="8" Height="8" HorizontalAlignment="Left" Margin="12,0,0,0"
                                   VerticalAlignment="Center" Fill="{StaticResource Stud}">
                            <Rectangle.RenderTransform>
                                <RotateTransform Angle="45" CenterX="4" CenterY="4"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <TextBlock x:Name="txt" Text="{TemplateBinding Content}" Margin="32,0,14,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="plate" Property="Background" Value="{StaticResource PlaqueOn}"/>
                            <Setter TargetName="txt" Property="Foreground" Value="#FFF2EDDD"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="plate" Property="Background" Value="{StaticResource PlaqueOn}"/>
                            <Setter TargetName="plate" Property="BorderBrush" Value="{StaticResource BronzeHi}"/>
                            <Setter TargetName="stud" Property="Fill" Value="#FF7FB4E0"/>
                            <Setter TargetName="txt" Property="Foreground" Value="#FFFFFFFF"/>
                            <Setter TargetName="txt" Property="FontWeight" Value="Bold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Category / part tabs ============================ -->
    <Style x:Key="PillToggle" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource TitleFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Typography.Capitals" Value="SmallCaps"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,5,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="b" Background="Transparent" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1" Padding="9,4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource GoldDeep}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            <Setter TargetName="b" Property="BorderThickness" Value="0,0,0,2"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentBright}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PillToggleSm" TargetType="ToggleButton" BasedOn="{StaticResource PillToggle}">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
    </Style>

    <!-- ============================ TextBox ============================ -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource ValueFont}"/>
        <Setter Property="Foreground" Value="#FFFFFFFF"/>
        <Setter Property="CaretBrush" Value="{StaticResource AccentBright}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AccentSoft}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="7,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b" Background="{StaticResource Inset}"
                            BorderBrush="{StaticResource GoldDeep}" BorderThickness="1">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource GoldLine}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Lock — a diamond that fills ============================ -->
    <Style x:Key="Switch" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="ToolTip" Value="Hold this value each frame"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Rectangle x:Name="d" Width="11" Height="11" Stroke="{StaticResource GoldLine}"
                                   StrokeThickness="1.3" Fill="Transparent"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Rectangle.RenderTransform>
                                <RotateTransform Angle="45" CenterX="5.5" CenterY="5.5"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="d" Property="Stroke" Value="{StaticResource AccentBright}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="d" Property="Fill" Value="{StaticResource Accent}"/>
                            <Setter TargetName="d" Property="Stroke" Value="{StaticResource AccentBright}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ ScrollBar ============================ -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="9"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#FF5A4626" Margin="3,1"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="9"/>
                            <Setter Property="Width" Value="Auto"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ ListBox (process picker) ============================ -->
    <Style x:Key="PlainListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Foreground" Value="{StaticResource Text}"/>
                    <Setter Property="Padding" Value="12,10"/>
                    <Setter Property="Margin" Value="0,2"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="b" Background="{StaticResource PlaqueOff}"
                                        BorderBrush="#FF241B0F" BorderThickness="1"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="{StaticResource PlaqueOn}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="{StaticResource PlaqueOn}"/>
                                        <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource BronzeHi}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
