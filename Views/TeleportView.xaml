<UserControl x:Class="EternalRingCompanion.Views.TeleportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="34,26,34,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Teleport" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0"
                           Text="Areas in game-progression order."/>
                <Border Style="{StaticResource Rule}"/>
            </StackPanel>
            <TextBlock x:Name="Status" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12,4,0,0"
                       FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,24">
            <StackPanel x:Name="List" MaxWidth="760" HorizontalAlignment="Left"/>
        </ScrollViewer>
    </Grid>
</UserControl>
